# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
ACN_ENV=local
ACN_LOG_LEVEL=INFO
ACN_TOP_K=3
ACN_MAX_TEXT_CHARS=2000
# Umbral de confianza del clasificador. Vacío = usa el calibrado en entrenamiento (0.30).
ACN_CONFIDENCE_THRESHOLD=
ACN_CORS_ORIGINS=http://localhost:8080,http://localhost:8000
# 1 worker por contenedor (estado en memoria por proceso; escalar con réplicas)
ACN_WORKERS=1

# --- Generación opcional con Claude (si se deja vacío, el servicio usa el modo extractivo offline) ---
ANTHROPIC_API_KEY=
ACN_LLM_ENABLED=true
ACN_LLM_MODEL=claude-opus-5-5
ACN_LLM_TIMEOUT_S=20
